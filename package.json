{
  "name": "dsh-codebase-memory",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin: connects the codebase-memory-mcp graph server, nudges the model toward it at the decision point, corrects failed MCP calls, and indexes unindexed repositories by itself.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./hook": "./hook.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "hook.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "mcp",
    "codebase-memory",
    "code-graph",
    "codebase-memory-mcp"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4"
  },
  "scripts": {
    "test": "node test/triggers.test.mjs && node test/corrections.test.mjs && node test/autoindex.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smter/dsh-codebase-memory.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
